{
  "manifest_version": 3,
  "name": "Omarchy Color Sync",
  "version": "1.0.1",
  "description": "Live-syncs browser chrome colors with the current Omarchy desktop theme.",
  "browser_specific_settings": {
    "gecko": {
      "id": "omarchy-firefox-theme@miyagi.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["theme", "nativeMessaging"],
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
