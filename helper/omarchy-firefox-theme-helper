#!/usr/bin/env python3
"""Native messaging helper for Omarchy → Firefox theme sync.

Lifecycle: Firefox spawns this script as a child process when the WebExtension
calls runtime.connectNative("omarchy_firefox_theme"), and reaps it when Firefox
exits or the extension is disabled. There is no daemon — this script's
lifetime is the extension's connection.

Behavior:
  - Push current theme to Firefox on startup.
  - Watch ~/.config/omarchy/current/ for `moved_to`/`create` of `theme/`
    (the atomic swap that omarchy-theme-set performs at lines 41-42).
  - On each event, re-read colors.toml and push a fresh theme.

Protocol: Firefox native messaging — 4-byte little-endian length prefix +
UTF-8 JSON, both directions. We send {"type": "theme", "theme": {...}};
we drain incoming frames but ignore the content.

Logs to stderr; Firefox forwards them to the extension console
(about:debugging → Inspect → Console).
"""
from __future__ import annotations

import json
import queue
import struct
import subprocess
import sys
import threading
import time
import tomllib
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from colors import omarchy_to_firefox_theme  # noqa: E402

THEME_DIR = Path.home() / ".config" / "omarchy" / "current" / "theme"
COLORS_TOML = THEME_DIR / "colors.toml"
PARENT = THEME_DIR.parent
DEBOUNCE_S = 0.15


def log(msg: str) -> None:
    print(f"[omarchy-firefox-theme] {msg}", file=sys.stderr, flush=True)


def send(obj: dict) -> None:
    data = json.dumps(obj).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("<I", len(data)))
    sys.stdout.buffer.write(data)
    sys.stdout.buffer.flush()


def push_theme() -> None:
    try:
        with open(COLORS_TOML, "rb") as f:
            palette = tomllib.load(f)
    except FileNotFoundError:
        log(f"colors.toml not found at {COLORS_TOML}; skipping push")
        return
    except tomllib.TOMLDecodeError as e:
        log(f"colors.toml malformed: {e}; skipping push")
        return
    try:
        theme = omarchy_to_firefox_theme(palette)
    except KeyError as e:
        log(f"palette missing required key {e}; skipping push")
        return
    send({"type": "theme", "theme": theme})
    log(f"pushed theme (bg={palette.get('background')}, accent={palette.get('accent')})")


def watcher_thread(q: queue.Queue) -> None:
    try:
        proc = subprocess.Popen(
            ["inotifywait", "-mq", "-e", "moved_to,create", str(PARENT)],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
    except FileNotFoundError:
        log("inotifywait not found (install inotify-tools); file watching disabled")
        return

    assert proc.stdout is not None
    for line in proc.stdout:
        # inotifywait line format: "<watched_dir> <event[,event...]> <name>"
        parts = line.strip().split(maxsplit=2)
        if len(parts) < 3:
            continue
        _, _, name = parts
        if name == "theme":
            q.put("change")


def stdin_drain_thread(q: queue.Queue) -> None:
    while True:
        hdr = sys.stdin.buffer.read(4)
        if len(hdr) < 4:
            q.put("exit")
            return
        (n,) = struct.unpack("<I", hdr)
        sys.stdin.buffer.read(n)


def main() -> int:
    q: queue.Queue = queue.Queue()
    threading.Thread(target=watcher_thread, args=(q,), daemon=True).start()
    threading.Thread(target=stdin_drain_thread, args=(q,), daemon=True).start()

    log("started")
    push_theme()

    last = 0.0
    while True:
        ev = q.get()
        if ev == "exit":
            log("Firefox closed the connection; exiting")
            return 0
        if ev == "change":
            now = time.monotonic()
            if now - last < DEBOUNCE_S:
                continue
            last = now
            push_theme()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except Exception as exc:
        log(f"fatal: {exc!r}")
        sys.exit(1)
